# Copy to .env.local and fill in your values.
# Production domain: consciouscine.org

# MySQL database (used by Prisma)
DATABASE_URL="mysql://root:your_password@localhost:3306/cci"

# Legacy mysql2 vars (optional — DATABASE_URL is preferred)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=cci

# NextAuth
AUTH_SECRET=generate_a_long_random_string_here
AUTH_TRUST_HOST=true
# Local: http://localhost:3000 — Production: https://consciouscine.org
AUTH_URL=https://consciouscine.org

# Google Places (reviews / location widgets)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=

# Email (Resend) — domain consciouscine.org
RESEND_API_KEY=
EMAIL_FROM="Conscious Cinema Initiative <onboarding@resend.dev>"
EMAIL_GENERAL=hello@consciouscine.org
EMAIL_MEDIA=media@consciouscine.org
LEAD_ADMIN_EMAIL=admin@consciouscine.org

# Payments
RAZORPAY_KEY_ID=
