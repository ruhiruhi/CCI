# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env*.example

# local session dumps (auth tokens)
cookies.txt
headers.txt
body.txt

# duplicate copies, archives, and raw media dumps (not app source)
*.zip
*.tar.gz
_deploy_extract/
_deploy_stage/
public_extracted/
drive-download-*/
Day1image/
Day2image/
.tmp-thumbs/
.tmp-day2-thumbs/
vdo_1.mp4
deploy-log.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# volunteer photo uploads (keep folder)
/public/uploads/volunteers/*
!/public/uploads/volunteers/.gitkeep
